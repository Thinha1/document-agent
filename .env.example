# BEGIN GENERATED CONNECTIONS
# Generated by scripts/generate_env_example.py; definitions live in tini/integrations.py

TINI_PROVIDER=anthropic

# ── AI Providers ──

# ── Anthropic ──
# Uses Anthropic models.
# ANTHROPIC_API_KEY=

# ── OpenAI ──
# Uses OpenAI models.
# OPENAI_API_KEY=
# Optional provider-specific endpoint override.
# OPENAI_BASE_URL=

# ── Custom OpenAI-Compatible ──
# Uses any OpenAI-compatible Chat Completions endpoint.
# Use a non-empty placeholder if the local server ignores authentication.
# CUSTOM_OPENAI_API_KEY=
# Required OpenAI-compatible endpoint; include /v1 when the server expects it.
# CUSTOM_OPENAI_BASE_URL=
# Optional gateway route prefix. For Bifrost, use the provider name configured in Bifrost; leave blank for a direct endpoint.
# CUSTOM_OPENAI_UPSTREAM_PROVIDER=

# ── Openrouter ──
# Uses Openrouter models.
# OPENROUTER_API_KEY=

# ── Gemini ──
# Uses Gemini models.
# GEMINI_API_KEY=

# ── Deepseek ──
# Uses Deepseek models.
# DEEPSEEK_API_KEY=
# Optional provider-specific endpoint override.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Minimax ──
# Uses Minimax models.
# MINIMAX_API_KEY=
# Choices: https://api.minimaxi.com/anthropic, https://api.minimax.io/anthropic.
# MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic

# ── Kimi ──
# Uses Kimi models.
# MOONSHOT_API_KEY=
# Choices: https://api.moonshot.ai/anthropic, https://api.moonshot.cn/anthropic.
# MOONSHOT_BASE_URL=https://api.moonshot.ai/anthropic

# ── Glm ──
# Uses Glm models.
# ZHIPU_API_KEY=
# Choices: https://api.z.ai/api/anthropic, https://open.bigmodel.cn/api/anthropic.
# ZHIPU_BASE_URL=https://api.z.ai/api/anthropic

# ── Xai ──
# Uses Xai models.
# XAI_API_KEY=

# ── Opencode Zen ──
# Uses Opencode Zen models.
# OPENCODE_ZEN_API_KEY=

# ── Opencode Go ──
# Uses Opencode Go models.
# OPENCODE_GO_API_KEY=

# ── Channels ──

# ── Telegram ──
# Lets Tini receive and send Telegram messages.
# Install: pip install -e '.[telegram]'
# Setup: https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER=

# ── Discord ──
# Lets Tini answer in a Discord server.
# Install: pip install -e '.[discord]'
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USER=
# DISCORD_ALLOWED_CHANNEL=
# Set to 1 to enable.
# DISCORD_REQUIRE_MENTION=
# DISCORD_MAX_TURNS_PER_HOUR=
# DISCORD_HOME=

# ── WhatsApp ──
# Lets Tini answer WhatsApp messages via the Meta Cloud API.
# Install: pip install -e '.[whatsapp]'
# Setup: https://developers.facebook.com/apps
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Without '+' prefix. Empty = answer anyone.
# WHATSAPP_ALLOWED_PHONE=

# ── Memory & Storage ──

# ── Notion ──
# Stores episodic memory in a Notion database.
# Install: pip install -e '.[notion]'
# Setup: https://www.notion.so/my-integrations
# Choices: sqlite, notion.
# TINI_EPISODIC_STORE=sqlite
# NOTION_TOKEN=
# NOTION_EPISODES_DATABASE_ID=

# ── Mem0 ──
# Stores semantic memory in the Mem0 service.
# Install: pip install -e '.[arena]'
# Choices: sqlite, mem0.
# TINI_SEMANTIC_STORE=sqlite
# From app.mem0.ai. The adapter sends infer=False so add() always stores — a bake-off against it measures retrieval, not Mem0's own extraction step.
# MEM0_API_KEY=
# Defaults to 'tini'. Change it only if several people share one Mem0 account.
# MEM0_USER_ID=

# ── Zep ──
# Stores semantic memory in a Zep temporal graph.
# Install: pip install -e '.[arena]'
# Choices: sqlite, zep.
# TINI_SEMANTIC_STORE=sqlite
# From getzep.com. Facts become graph edges with validity dates, so a correction supersedes the old value instead of ranking beside it — the one backend built for the update test.
# ZEP_API_KEY=
# Defaults to 'tini'. Zep scopes a graph per user.
# ZEP_USER_ID=
# Ingestion is asynchronous: graph.add returns in ~0.2s with the episode unprocessed, and the text is not searchable until Zep has turned it into nodes and edges. Tini polls until it has, up to this long. Default 120 — raise it if seeding times out, never lower it to make a benchmark finish.
# ZEP_MAX_WAIT_SECONDS=

# ── LangMem ──
# Stores semantic memory in a LangGraph store via LangMem.
# Install: pip install -e '.[arena]'
# Choices: sqlite, langmem.
# TINI_SEMANTIC_STORE=sqlite
# Optional. Without it LangGraph's InMemoryStore is used, which its own docs describe as a reference implementation whose data dies with the process — fine for a benchmark run, not a persistence story.
# TINI_LANGMEM_POSTGRES=
# LangMem has no key of its own; it bills through embeddings. Semantic search needs this or the store is a plain key-value dict.
# OPENAI_API_KEY=

# ── Supabase ──
# Stores semantic memory in Supabase pgvector.
# Install: pip install -e '.[supabase]'
# Choices: sqlite, supabase.
# TINI_SEMANTIC_STORE=sqlite
# SUPABASE_URL=
# Embeddings also require OPENAI_API_KEY (optionally OPENAI_EMBED_MODEL).
# SUPABASE_SERVICE_KEY=

# ── Search & Observability ──

# ── SearXNG ──
# Searches operator-controlled sources through a self-hosted SearXNG instance.
# Setup: https://docs.searxng.org/admin/installation-searxng.html
# Enable json in the instance's search.formats setting.
# SEARXNG_BASE_URL=

# ── OpenTelemetry ──
# Exports traces to an OTLP collector.
# Install: pip install -e '.[tracing]'
# OTEL_EXPORTER_OTLP_ENDPOINT=

# END GENERATED CONNECTIONS

# ── Models (optional) ───────────────────────────────────────────────────────
# Each provider has sensible defaults (see tini/loop/models.py PROVIDERS):
#   anthropic:  claude-sonnet-5              + claude-haiku-4-5 (gate/summarizer)
#   openai:     gpt-5.5                      + gpt-4.1-mini
#   gemini:     gemini-3.5-flash             + gemini-3.1-flash-lite
#   deepseek:   deepseek-v4-pro              + deepseek-v4-pro
#   minimax:    MiniMax-M3                   + MiniMax-M2
#   kimi:       kimi-k3                      + kimi-k2.6 (gate/summarizer)
#               (K3-only key? set TINI_SMALL_MODEL=kimi-k3 too)
#   glm:        glm-5.2                      + glm-5-turbo
#   openrouter: nemotron-3-super:free        + gemma-4-26b:free (both $0,
#               rate-limited; Settings lists the live catalog, free first)
# openrouter's whole point is picking a different model, so TINI_MODEL takes
# any "<vendor>/<model>" slug from https://openrouter.ai/models — e.g.
# TINI_MODEL=meta-llama/llama-3.1-70b-instruct
# Any OpenAI-compatible API (local server, proxy, or another provider):
#   TINI_PROVIDER=custom_openai
#   CUSTOM_OPENAI_API_KEY=
#   CUSTOM_OPENAI_BASE_URL=https://provider.example/v1
#   CUSTOM_OPENAI_UPSTREAM_PROVIDER=  # e.g. openai for a Bifrost route
#   TINI_MODEL=your-model-id
#   TINI_SMALL_MODEL=your-small-model-id  # optional; defaults to main model
# Use the named DeepSeek provider instead:
#   TINI_PROVIDER=deepseek
#   DEEPSEEK_API_KEY=
#   DEEPSEEK_BASE_URL=https://api.deepseek.com
# Override either provider's default model ids when needed:
# TINI_MODEL=
# TINI_SMALL_MODEL=
# Legacy global overrides; prefer the provider-specific keys above so URLs do
# not leak when TINI_PROVIDER changes:
# TINI_BASE_URL=
# TINI_API_KEY=

# ── Embedding model (separate from the chat model) ─────────────────────────
# Unset/none keeps document retrieval on SQLite FTS5 only. When configured,
# ingestion stores vectors and retrieval combines vector similarity with FTS5.
# Choices: none, gemini, openai, openai_compatible.
# TINI_EMBEDDING_PROVIDER=gemini
# TINI_EMBEDDING_MODEL=gemini-embedding-2
# Recommended starting size for Gemini; changing it requires re-embedding all chunks.
# TINI_EMBEDDING_DIMENSIONS=768
# Optional dedicated key. If blank, gemini falls back to GEMINI_API_KEY and
# openai falls back to OPENAI_API_KEY.
# TINI_EMBEDDING_API_KEY=
# Required for openai_compatible; include /v1 when the server expects it.
# TINI_EMBEDDING_BASE_URL=https://embedding-provider.example/v1

# ── Tini home (optional) ──────────────────────────────────────────────────
# Where memory (state.db), MCP config, and traces live.
# TINI_HOME=.tini

# ── Loop guardrails (optional) ──────────────────────────────────────────────
# TINI_MAX_ITERATIONS=10
# TINI_MAX_TOKENS=8192
# Working memory window: how many recent turns enter the prompt (default 12).
# Older turns stay in state.db + consolidation; the retrieval gate brings them
# back when relevant. Caps context/cost/latency on long (esp. Telegram) threads.
# TINI_HISTORY_TURNS=12

# ── Memory tuning (optional) ────────────────────────────────────────────────
# Consolidate chats into durable facts only after N new exchanges.
# TINI_CONSOLIDATE_EVERY=6
# TINI_RETRIEVAL_TOP_K=4

# ── Internal document ingestion (optional) ─────────────────────────────────
# Logical isolation key used for both indexing and retrieval.
# TINI_DOCUMENT_WORKSPACE=default
# Structure-aware chunks split at headings, paragraphs, and sentences. These
# token estimates are guardrails, not fixed chunk lengths.
# TINI_DOCUMENT_CHUNK_MAX_TOKENS=512
# TINI_DOCUMENT_CHUNK_MIN_TOKENS=120
# TINI_DOCUMENT_CHUNK_OVERLAP_TOKENS=48
# Reject unexpectedly large files before parsing (default 25 MiB).
# TINI_DOCUMENT_MAX_FILE_BYTES=26214400
# Limit extracted text as a second guard against compressed document bombs.
# TINI_DOCUMENT_MAX_TEXT_CHARS=5000000
# Document index backend: 'sqlite' (default, zero setup) or 'qdrant'
# (self-hosted vector upgrade path). See docker-compose.yml and
# tini/documents/qdrant_store.py. Qdrant is semantic-only — set
# TINI_EMBEDDING_PROVIDER above too, and: pip install 'tini-agent[qdrant]'
# TINI_DOCUMENT_INDEX=sqlite
# TINI_QDRANT_URL=http://localhost:6333
# TINI_QDRANT_API_KEY=
# TINI_QDRANT_COLLECTION=tini_documents
# Fuse a keyword (BM25-style) ranking with vector search on Qdrant. Off by
# default: it did not beat dense-only on the DENSO set. An existing collection
# must be copied first: python scripts/qdrant_add_hybrid.py SOURCE TARGET
# TINI_DOCUMENT_HYBRID=0
# TINI_DOCUMENT_FUSION=rrf
# TINI_DOCUMENT_LEXICAL_WEIGHT=1.0
# Also search a question's translation into each language listed here (one
# small-model call per new question, cached). Empty (default) = off; measured
# a net loss on the DENSO set (docs/document-ingestion.md) — try it on a
# genuinely cross-language corpus before turning it on.
# TINI_QUERY_LANGUAGES=
# OCR fallback for image-only/scanned PDF pages (a page averaging under ~40
# extracted chars is treated as scanned). Unset by default: such a page is
# left as-is, with an ocr_skipped note in its metadata rather than a silent
# near-empty document. See tini/documents/ocr.py — CPU-only local OCR
# (PaddleOCR) was tried and abandoned (crashed/hung on this project's oneDNN
# CPU backend); this calls a vision-capable chat model instead, over the
# same openai-compatible wire format the embedding providers use:
# pip install 'tini-agent[ocr]'
# TINI_OCR_PROVIDER=deepseek
# TINI_OCR_MODEL=deepseek-v4-flash-vision-exp
# TINI_OCR_API_KEY=
# TINI_OCR_BASE_URL=
# How many pages of the SAME document are OCR'd at once (each call is a
# multi-second network round trip; pages are independent). Keep modest
# against a hosted vision API's own rate limits.
# TINI_OCR_CONCURRENCY=4
# A scanned page's single OCR call also has to render any table as Markdown,
# which the chunker then can't tell apart from prose (a wide table gets cut at
# a raw token offset, header lost — see docs/document-ingestion.md). Off by
# default, not yet measured: when on, that call skips tables (leaving a
# marker) and a second, table-only call — only for a page a marker was found
# on — extracts them as rows the chunker splits by row instead.
# TINI_OCR_TABLE_FLOW=0
# Cache document chunk vectors so re-ingesting an unchanged or lightly edited
# file re-embeds only what changed (default on; 0 turns it off).
# TINI_EMBEDDING_CACHE=1
# Where dashboard-uploaded ORIGINAL files are kept: local (default, under
# TINI_HOME) or minio (any S3-compatible server; documents then carry an
# s3:// source_uri). pip install 'tini-agent[minio]'; with docker compose:
# `docker compose --profile minio up -d`. No default credentials — choose them.
# TINI_DOCUMENT_STORAGE=minio
# TINI_MINIO_ENDPOINT=localhost:9000
# TINI_MINIO_ACCESS_KEY=
# TINI_MINIO_SECRET_KEY=
# TINI_MINIO_BUCKET=tini-documents
# TINI_MINIO_SECURE=0
# Reranking (off by default): fetch TINI_RERANK_CANDIDATES chunks by vector
# similarity, then let a second model reorder them against the question.
# PRIVACY: with provider=jev the question and those chunks' text are sent to
# api.typesafe.ai on every search (the endpoint is fixed in the code, not a
# setting). Leave it at none to keep chunk text on this machine.
# TINI_RERANK_PROVIDER=jev
# TYPESAFE_API_KEY=            # or TINI_RERANK_API_KEY
# TINI_RERANK_MODEL=jev-latest
# TINI_RERANK_CANDIDATES=20

# ── Open files in your editor (optional) ────────────────────────────────────
# Dashboard "reveal" links open files in this editor when it's on PATH
# (falls back to cursor, then code, then Finder):
# TINI_EDITOR=cursor

# ── Graph orchestration (optional) ─────────────────────────────────────────
# Triage every message through a graph: small-model classification followed by
# either a quick reply or the normal retrieval loop as a node.
# Fails open to the plain loop on any error. See tini/graph/.
# TINI_GRAPH_WORKFLOWS=1

# ── MCP servers (optional): pip install -e '.[mcp]' ─────────────────────────
# Connect Model Context Protocol servers by creating .tini/mcp.json:
#   {"servers": [{"name": "fs", "command": "npx",
#                 "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]}]}
# Their tools register as <server>_<tool> and appear to the agent automatically.

# ── Voice gateway (optional): pip install -e '.[voice]' ────────────────────
# Unset = push-to-talk (Enter, speak, Enter). Set a wake word — ANY phrase —
# and `make voice` becomes always-listening:
# TINI_WAKE_WORD=tini tini
# What it says when it wakes:
# TINI_WAKE_ACK=Yes?
# Stay in the conversation after answering (Siri-style) for N seconds before
# needing "tini tini" again:
# TINI_FOLLOWUP_SECONDS=8
# STT model (tiny/base/small — bigger = more accurate, slower):
# TINI_WHISPER_MODEL=base
# TTS engine: 'say' (macOS built-in, default) or 'kokoro' (neural British
# butler — first: pip install kokoro soundfile):
# TINI_TTS=say
# TINI_VOICE=Daniel
# (for kokoro use voices like bm_george / bm_fable)
# Mic sensitivity: lower if it never hears you, higher if it wakes on noise:
# TINI_MIC_THRESHOLD=0.005

# ── Reliability (optional) ──────────────────────────────────────────────────
# Max seconds any single LLM call may take before erroring instead of hanging:
# TINI_LLM_TIMEOUT=120
